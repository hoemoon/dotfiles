#!/usr/bin/env python3
"""dotfiles 를 최신으로 맞춘다. 여러 번 돌려도 안전하다.

    ~/dotfiles/bin/sync

하는 일: pull 하고, 빠진 심링크를 걸고, 공유분을 끌어오는 한 줄들이
있는지 보고, Brewfile 을 맞춘다. 심링크가 저장소를 가리키므로 기존 파일의
내용 변경은 pull 만으로 반영된다. pull 이 못 하는 건 ① 새로 추가된 파일의
링크, ② 바뀐 Brewfile 설치, 그리고 ③ 저장소를 아직 안 가리키는 로컬 파일이다.

③ 이 여기서 다루는 가장 조용한 실패다. 로컬 파일이 공유분을 안 부르면
pull 은 성공하고 셸도 정상인데 새 설정만 없다 — 에러가 없으니 알아챌 방법이
없다. 그래서 참조 한 줄(zsh)과 [include] 한 줄(git)이 있는지 매번 확인하고,
없으면 덧붙인다. 옛 본문이 그대로 남아 공유분과 겹치는 줄도 짚어준다.

이미 맞는 건 건드리지 않고, 남의 파일은 절대 덮어쓰지 않는다.
확인할 게 있으면 종료코드 1.
"""

import argparse
import os
import re
import shutil
import subprocess
import sys
from pathlib import Path

sys.path.insert(0, str(Path(__file__).resolve().parent))
import _bootstrap  # noqa: E402

# 여기서 Homebrew python + rich 로 갈아탄다. 아래 코드는 그 환경에서만 돈다.
_bootstrap.ensure(create=False)

from _ui import UI  # noqa: E402

HOME = Path.home()
DOTFILES = _bootstrap.DOTFILES

# 심링크로 거는 것 — 남이 건드리지 않는 파일·디렉터리만.
LINKS = [
    ("nvim", HOME / ".config/nvim"),
    ("ghostty", HOME / ".config/ghostty"),
    ("git/ignore", HOME / ".config/git/ignore"),
]

# source 로 참조하는 것 — 설치기(OrbStack·nvm·conda…)가 덧붙이는 파일이라
# 저장소가 통째로 소유하면 안 된다. 한 줄이 있는지만 보고, 없으면 덧붙인다.
# 덧붙이기는 파괴적이지 않으므로 사람에게 물어볼 일이 없다.
SOURCES = [
    (HOME / ".zshenv", "zsh/env.zsh", "이 기기의 환경변수"),
    (HOME / ".zprofile", "zsh/profile.zsh", "이 기기의 로그인 셸 설정"),
    (HOME / ".zshrc", "zsh/rc.zsh", "이 기기의 대화형 셸 설정"),
]

# ~/.gitconfig 은 추적하지 않는다 — 신원 정보고 이 저장소는 공개다. 파일은
# setup 이 만들고, 여기서는 공유분을 끌어오는 [include] 한 줄만 본다.
#
# 이 확인이 없으면 조용히 실패한다: 저장소를 알기 *전부터* ~/.gitconfig 이
# 있던 기기에서는 setup 의 step_gitconfig 이 "이미 있음" 으로 건너뛰므로
# include 가 영원히 안 붙고, git/shared 가 아무 효과도 내지 않는다.
# 에러는 안 난다 — delta 도 별칭도 그냥 없는 상태로 지나간다.
GIT_SHARED = "git/shared"

# 맨 위에 붙인다. git 은 뒤에 오는 값이 이기므로, include 가 위에 있어야
# 아래에서 같은 키를 다시 적어 이 기기에서만 덮어쓸 수 있다(git/README.md).
# 덧붙이기가 아니라 앞에 붙이기인 이유가 이것이다 — 뒤에 붙이면 공유분이
# 기존 로컬 값을 이겨서 의미가 거꾸로 된다.
GIT_INCLUDE_BLOCK = """\
# 공유 git 설정. 이 include 는 맨 위에 있어야 한다 — 아래에서 같은 키를
# 다시 적으면 이 기기에서만 공유분을 덮어쓸 수 있다.
[include]
\tpath = ~/dotfiles/{rel}

"""

# 참조 파일(~/.zshrc 등)에 남아 있으면 공유분과 겹치는 것들. 저장소가 이미
# 하는 일을 로컬 파일이 한 번 더 하면 두 번 로드되거나 서로를 덮어쓴다.
#
# source 줄을 덧붙이는 것만으로는 이 상태가 안 풀린다는 게 요점이다. 옛 본문이
# 그대로 남은 채 공유분이 뒤에 붙으면 플러그인이 두 벌 로드되고 프롬프트가
# 겹친다 — 그런데도 셸은 열리므로 경고 없이는 알 수 없다.
#
# 지우는 건 사람이 한다. 남의 파일은 고치지 않는다(step_sources 와 같은 원칙).
# 주석은 걸러내지만 셸 문법을 파싱하지는 않는다 — 오탐이 있어도 경고일 뿐이다.
CONFLICTS = [
    (re.compile(r"\bantidote\s+load\b"),
     "플러그인이 두 벌 로드된다 — rc.zsh 의 compinit 전/후 2단 순서가 깨진다"),
    (re.compile(r"\bcompinit\b"),
     "compinit 이 두 번 돈다 — rc.zsh 가 이미 24시간 캐시로 돌린다"),
    (re.compile(r"\bstarship\s+init\b"),
     "걷어낸 프롬프트다 — rc.zsh 의 내장 프롬프트 위에 다시 얹힌다"),
    (re.compile(r"\bzoxide\s+init\b"), "zoxide 가 두 번 초기화된다"),
    (re.compile(r"\bfzf\s+--zsh\b"), "fzf 키바인딩이 두 번 걸린다"),
    (re.compile(r"^\s*R?PROMPT="), "rc.zsh 의 프롬프트를 덮어쓴다"),
]

# brew 로 깔리지만 폴백이 없는 것 — 없으면 설정이 있는 채로 깨진다.
# (셸 별칭은 `(( $+commands[...] ))` 로 스스로 건너뛰므로 여기 없다.)
NO_FALLBACK = [
    ("delta", "git 이 페이저를 못 찾아 diff·log 출력이 깨진다 (core.pager)"),
]


def tilde(p: Path) -> str:
    s, h = str(p), str(HOME)
    return "~" + s[len(h):] if s.startswith(h) else s


def run(cmd, cwd=None):
    env = dict(os.environ, HOMEBREW_NO_AUTO_UPDATE="1")
    return subprocess.run(cmd, cwd=cwd, env=env, stdout=subprocess.PIPE,
                          stderr=subprocess.STDOUT, text=True)


def step_pull(ui: UI) -> None:
    with ui.step("pull") as s:
        before = run(["git", "rev-parse", "HEAD"], cwd=DOTFILES).stdout.strip()
        p = run(["git", "pull", "--ff-only", "--quiet"], cwd=DOTFILES)
        if p.returncode != 0:
            s.fail("git pull 실패", output=p.stdout,
                   hint="충돌이나 미커밋 변경을 정리하고 다시 실행할 것\n"
                        "cd {} && git status".format(tilde(DOTFILES)))
            return
        after = run(["git", "rev-parse", "HEAD"], cwd=DOTFILES).stdout.strip()
        if before == after:
            s.skip("이미 최신")
            return
        n = len(run(["git", "log", "--oneline", before + ".." + after],
                    cwd=DOTFILES).stdout.strip().splitlines())
        s.ok("커밋 {}개 받음".format(n))


def step_links(ui: UI) -> None:
    with ui.step("링크") as s:
        created, problems = [], []
        for rel, dst in LINKS:
            target = DOTFILES / rel
            if not target.exists():
                problems.append("저장소에 {} 가 없다".format(rel))
                continue
            if dst.is_symlink():
                if dst.readlink() != target:
                    problems.append(
                        "{} 가 {} 를 가리킨다 (기대: {})".format(
                            tilde(dst), dst.readlink(), tilde(target)))
                continue
            if dst.exists():
                # 내용이 같으면 물어볼 이유가 없다 — 링크로 바꿔도 잃는 게 0이다.
                # 이 확인이 없어서 "확인 후 지울 것" 경고가 무의미하게 떴다.
                if (dst.is_file() and target.is_file()
                        and dst.read_bytes() == target.read_bytes()):
                    dst.unlink()
                    dst.symlink_to(target)
                    created.append(tilde(dst) + " (내용 동일)")
                    continue
                problems.append(
                    "{d} 에 다른 내용의 파일이 있다:\n"
                    "  diff {d} {t}\n"
                    "  살릴 게 없으면:  rm {d} && bin/sync\n"
                    "  있으면: 저장소({t}) 에 반영·커밋한 뒤 위와 같이"
                    .format(d=tilde(dst), t=tilde(target)))
                continue
            dst.parent.mkdir(parents=True, exist_ok=True)
            dst.symlink_to(target)
            created.append(tilde(dst))

        # 경고가 있어도 무엇이 생성됐는지는 알려준다. 이전 판은 문제가 하나라도
        # 있으면 생성 목록을 통째로 삼켰다 — 링크 3개가 걸렸는데 화면엔 경고만 떴다.
        if problems and created:
            s.warn("{}개 생성 · {}건 확인 필요".format(len(created), len(problems)),
                   hint="\n".join(problems))
            for c in created:
                ui.note(c)
        elif problems:
            s.warn("{}건 확인 필요".format(len(problems)), hint="\n".join(problems))
        elif created:
            s.ok("{}개 생성".format(len(created)))
            for c in created:
                ui.note(c)
        else:
            s.skip("이상 없음")


def step_sources(ui: UI) -> None:
    """공유 설정을 참조하는 한 줄이 있는지 본다. 없으면 덧붙인다.

    심링크와 달리 남의 파일을 소유하지 않는다 — OrbStack 이 ~/.zprofile 에
    써넣은 줄("This won't be added again if you remove it")을 지우지 않고
    그 옆에 우리 줄을 둘 수 있다.
    """
    with ui.step("공유 설정 참조") as s:
        added = []
        for path, rel, title in SOURCES:
            line = "source ~/dotfiles/{}".format(rel)
            text = path.read_text() if path.is_file() else ""
            if rel in text:
                continue
            with path.open("a") as f:
                if text and not text.endswith("\n"):
                    f.write("\n")
                f.write("\n# {} — 공유분은 아래 source 가 끌어온다.\n{}\n"
                        .format(title, line))
            added.append(tilde(path))
        if added:
            s.ok("{}개에 추가".format(len(added)))
            for a in added:
                ui.note(a)
        else:
            s.skip("이상 없음")


def step_brew(ui: UI) -> None:
    with ui.step("패키지") as s:
        brewfile = DOTFILES / "Brewfile"
        if shutil.which("brew") is None:
            s.fail("brew 가 없다",
                   hint="Homebrew 를 설치하고 다시 실행할 것\n"
                        "~/dotfiles/bin/setup")
            return
        if run(["brew", "bundle", "check", "--file", str(brewfile)]).returncode == 0:
            s.skip("충족")
            return

        s.progress("설치 중…")
        p = run(["brew", "bundle", "--file", str(brewfile)])
        if p.returncode != 0:
            # 흔한 실패는 원인을 짚어준다. "위 출력 확인" 은 안내가 아니다.
            if "untrusted tap" in p.stdout:
                hint = ("서드파티 탭을 신뢰해야 한다:\n"
                        "brew trust laishulu/homebrew\n"
                        "쓰지 않을 거면 Brewfile 에서 tap/macism 두 줄을 지울 것")
            elif "No available formula" in p.stdout:
                hint = ("Brewfile 의 이름이 틀렸거나 탭이 빠졌다. 위 줄을 확인할 것")
            else:
                hint = "위 오류를 해결하고 다시 실행할 것"
            s.fail("brew bundle 실패", output=p.stdout, hint=hint)
            return
        n = sum(1 for l in p.stdout.splitlines() if l.startswith("Installing"))
        s.ok("{}개 설치".format(n) if n else "충족")


def step_conflicts(ui: UI) -> None:
    """참조 파일에 공유분과 겹치는 옛 줄이 남아 있는지 본다.

    step_sources 는 "우리 줄이 있나" 만 본다. 그것만으로는 부족하다 —
    저장소를 알기 전부터 쓰던 ~/.zshrc 는 본문이 그대로 남은 채 맨 아래에
    source 줄만 붙는다. 셸은 열리고 에러도 없는데 플러그인이 두 벌 로드되고
    프롬프트가 겹친 상태가 된다. 그래서 겹치는 줄을 짚어준다.
    """
    with ui.step("겹치는 로컬 설정") as s:
        found = []
        for path, _rel, _title in SOURCES:
            if not path.is_file():
                continue
            for n, line in enumerate(path.read_text().splitlines(), 1):
                if line.lstrip().startswith("#") or not line.strip():
                    continue
                for pat, why in CONFLICTS:
                    if pat.search(line):
                        found.append("{}:{}  {}\n  {}".format(
                            tilde(path), n, line.strip(), why))
                        break
        if not found:
            s.skip("이상 없음")
            return
        s.warn("{}줄이 공유분과 겹친다".format(len(found)),
               hint="\n".join(found) + "\n지운 뒤:  exec zsh")


def _git_include_paths() -> list:
    """~/.gitconfig 의 include.path 값들. git 에게 직접 묻는다.

    파일을 문자열로 훑지 않는 이유: 경로 표기가 여러 가지다(~ · 절대경로 ·
    상대경로). git 이 읽는 값을 그대로 받아 경로로 비교하는 게 정확하다.

    `--global` 은 그 파일 하나만 읽고 include 를 따라 들어가지 않는다(실측).
    알고 싶은 게 바로 그것이다 — 끌어온 값이 아니라, 이 파일에 그 줄이 있나.
    """
    out = run(["git", "config", "--global", "--get-all", "include.path"]).stdout
    paths = []
    for line in out.splitlines():
        v = line.strip()
        if not v:
            continue
        path = Path(v).expanduser()
        # 상대경로는 포함하는 파일(~/.gitconfig)의 디렉터리 기준이다.
        if not path.is_absolute():
            path = HOME / path
        paths.append(path)
    return paths


def step_gitconfig(ui: UI) -> None:
    """공유 git 설정을 끌어오는 [include] 한 줄을 확인하고, 없으면 앞에 붙인다.

    brew 다음에 오는 게 중요하다 — include 가 걸리는 순간 core.pager 가
    delta 를 가리키므로, delta 가 아직 없으면 그때부터 git diff 가 깨진다.
    """
    with ui.step("~/.gitconfig") as s:
        path = HOME / ".gitconfig"
        want = (DOTFILES / GIT_SHARED).resolve()
        if not path.is_file():
            s.warn("없다 — 신원 정보라 이 스크립트가 만들지 않는다",
                   hint="~/dotfiles/bin/setup  (이름·이메일을 묻고 만든다)\n"
                        "git/README.md 참고")
            return

        added = False
        if not any(q == want for q in (x.resolve() for x in _git_include_paths()
                                       if x.exists())):
            text = path.read_text()
            path.write_text(GIT_INCLUDE_BLOCK.format(rel=GIT_SHARED) + text)
            added = True

        # 폴백 없는 의존은 include 가 걸린 뒤에만 문제가 된다. 순서상 brew 가
        # 이미 돌았으니, 여기서 없다면 설치가 실패한 것이다.
        broken = [(c, why) for c, why in NO_FALLBACK if shutil.which(c) is None]
        if broken:
            s.warn("include {} · {}개가 빠졌다".format(
                       "추가" if added else "있음", len(broken)),
                   hint="\n".join("{} 없음 — {}".format(c, why)
                                  for c, why in broken)
                        + "\nbrew bundle 이 실패했는지 위를 확인할 것")
            return
        if added:
            s.ok("[include] 추가 — 맨 위")
            ui.note("git/shared: delta 페이저 · zdiff3 · ds·dw 별칭")
        else:
            s.skip("이상 없음")


def main() -> int:
    ap = argparse.ArgumentParser(description="dotfiles 를 최신으로 맞춘다.")
    ap.add_argument("-v", "--verbose", action="store_true",
                    help="생략 없이 전부 보여준다")
    args = ap.parse_args()

    if not (DOTFILES / ".git").exists():
        print("{} 가 git 저장소가 아니다.".format(DOTFILES), file=sys.stderr)
        return 2

    ui = UI(verbose=args.verbose)
    ui.title("dotfiles sync", tilde(DOTFILES))
    step_pull(ui)
    step_links(ui)
    step_sources(ui)
    step_conflicts(ui)
    step_brew(ui)
    # gitconfig 은 brew 뒤다 — include 가 delta 를 페이저로 지정하므로
    # 설치보다 먼저 걸면 그 사이 git diff 가 깨진다.
    step_gitconfig(ui)
    return ui.done("이상 없음")


if __name__ == "__main__":
    sys.exit(main())
