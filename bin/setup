#!/usr/bin/env python3
"""새 기기 첫 세팅. clone 직후 한 번만 돌린다.

    git clone https://github.com/hoemoon/dotfiles.git ~/dotfiles
    ~/dotfiles/bin/setup

질문은 앞에 모아서 한 번에 묻고, 그 뒤로는 멈추지 않는다. 이미 되어 있는
항목은 묻지도 않는다. 여러 번 돌려도 안전하다.

모든 답은 플래그로도 줄 수 있다(`--help`). 그러면 아무것도 묻지 않으므로
자동화와 테스트가 가능하다 — 대화형은 값이 빠졌을 때의 폴백일 뿐이다.
"""

# ── 부트스트랩: 여기까지는 아무 python3 에서나 돌아야 한다 ────────────
import os
import subprocess
import sys
from pathlib import Path

sys.path.insert(0, str(Path(__file__).resolve().parent))
import _bootstrap  # noqa: E402


def _install_homebrew_if_missing() -> None:
    """venv 를 brew python 위에 만들어야 하므로 Homebrew 가 선행이다.

    rich 를 아직 못 쓰는 구간이라 출력이 투박하다. 설치 스크립트 자체가
    진행 표시와 sudo 프롬프트를 내므로 출력을 잡지 않는다.
    """
    for p in ("/opt/homebrew", "/usr/local"):
        if (Path(p) / "bin/brew").is_file():
            return
    print("Homebrew 를 설치한다. 관리자 암호를 묻는다.\n")
    url = ("https://raw.githubusercontent.com/Homebrew/install/HEAD/install.sh")
    got = subprocess.run(["curl", "-fsSL", url], stdout=subprocess.PIPE, text=True)
    if got.returncode != 0:
        sys.exit("Homebrew 설치 스크립트를 받지 못했다. 네트워크를 확인할 것.")
    if subprocess.run(["/bin/bash", "-c", got.stdout]).returncode != 0:
        sys.exit("Homebrew 설치에 실패했다.")


if not _bootstrap.running_in_venv():
    _install_homebrew_if_missing()
    _bootstrap.ensure(create=True, on_progress=lambda m: print(m))

# ── 여기서부터 Homebrew python + rich ────────────────────────────────
import argparse  # noqa: E402
import datetime  # noqa: E402
import shutil  # noqa: E402

from rich.console import Console  # noqa: E402

from _ui import UI  # noqa: E402

HOME = Path.home()
DOTFILES = _bootstrap.DOTFILES
GHOSTTY_APPCFG = HOME / "Library/Application Support/com.mitchellh.ghostty/config"
TAP = "laishulu/homebrew"
STAMP = datetime.date.today().strftime("%Y%m%d")

# 신원만 적는다. 공유분을 끌어오는 [include] 는 뒤이어 도는 sync 가 맨 위에
# 붙인다 — 그 한 줄의 주인은 bin/sync 하나다. 여기서도 적으면 같은 경로가
# 두 곳에 박혀 한쪽만 고쳐지는 날이 온다. (sync 는 이미 있던 ~/.gitconfig
# 에도 붙이므로, 저장소를 알기 전부터 쓰던 기기까지 같은 경로로 처리된다.)
GITCONFIG = """\
# 이 기기의 git 설정. 공유분은 sync 가 붙인 맨 위 [include] 가 끌어온다.
# 같은 키를 그 아래에 다시 적으면 이 기기에서만 공유분을 덮어쓴다.

[user]
\tname = {name}
\temail = {email}
"""

# zsh 는 심링크가 아니라 source 로 참조한다. ~/.zshrc·~/.zprofile 은
# 설치기(OrbStack·nvm·conda…)가 덧붙이는 파일이라 저장소가 소유하면 안 된다.
ZSHENV = """\
# 이 기기의 환경변수. 공유분은 아래 source 가 끌어온다.
# 기기에 묶인 값(자격증명 등)만 그 아래에 적는다 — 이 파일은 추적되지 않는다.
source ~/dotfiles/zsh/env.zsh
"""

ZPROFILE = """\
# 이 기기의 로그인 셸 설정. 공유분은 아래 source 가 끌어온다.
# 설치기들이 이 파일에 덧붙인다 — 그러라고 참조 방식을 쓴다.
source ~/dotfiles/zsh/profile.zsh
"""

ZSHRC = """\
# 이 기기의 대화형 셸 설정. 공유분은 아래 source 가 끌어온다.
#
# ⚠ 여기서 고친 건 이 기기에만 남는다. 두 기기에 다 반영하려면
#   ~/dotfiles/zsh/rc.zsh 를 고칠 것.
source ~/dotfiles/zsh/rc.zsh
"""

ZSHENV_ASC = """
# App Store Connect. Issuer ID 는 Keychain 에 두고 평문으로 적지 않는다.
export ASC_KEY_ID={key_id}
export ASC_KEY_PATH="$HOME/.appstoreconnect/private_keys/AuthKey_{key_id}.p8"
[[ -n $ASC_ISSUER_ID ]] || export ASC_ISSUER_ID="$(security find-generic-password -s ASC_ISSUER_ID -w 2>/dev/null)"
"""


def run(cmd, capture=True):
    env = dict(os.environ, HOMEBREW_NO_AUTO_UPDATE="1")
    if capture:
        return subprocess.run(cmd, env=env, stdout=subprocess.PIPE,
                              stderr=subprocess.STDOUT, text=True)
    return subprocess.run(cmd, env=env)


def ok(cmd) -> bool:
    return run(cmd).returncode == 0


def tilde(p: Path) -> str:
    s, h = str(p), str(HOME)
    return "~" + s[len(h):] if s.startswith(h) else s


# ── 질문 ─────────────────────────────────────────────────────────────
class Prompter:
    """질문을 /dev/tty 로 직결한다.

    stdout 에 찍으면 그걸 캡처하는 쪽이 프롬프트 문구를 값으로 삼는다.
    tty 직결이면 stdout 이 어디로 가든 무관하다.
    """

    def __init__(self, total: int) -> None:
        self.total, self.asked = total, 0
        try:
            self._in = open("/dev/tty", "r")
            self._c = Console(file=open("/dev/tty", "w"), highlight=False)
        except OSError:
            self._in = self._c = None

    @property
    def available(self) -> bool:
        return self._in is not None

    def _read(self) -> str:
        line = self._in.readline()
        if line == "":
            raise SystemExit("\n입력이 끊겼다 — 중단한다.")
        return line.strip()

    def _tag(self) -> str:
        self.asked += 1
        return "[dim]{}/{}[/dim]".format(self.asked, self.total)

    def ask(self, prompt: str) -> str:
        self._c.print("  {} {}: ".format(self._tag(), prompt), end="")
        while True:
            v = self._read()
            if v:
                return v
            self._c.print("      [yellow]비워둘 수 없다[/yellow] {}: ".format(prompt),
                          end="")

    def ask_yn(self, prompt: str, default: bool) -> bool:
        # 대괄호를 이스케이프하지 않으면 rich 가 마크업 태그로 읽어 통째로
        # 사라진다(실측: [y/N] 이 화면에서 없어졌다).
        hint = "\\[Y/n]" if default else "\\[y/N]"
        self._c.print("  {} {} [dim]{}[/dim] ".format(self._tag(), prompt, hint),
                      end="")
        a = self._read()
        return default if not a else a[:1].lower() == "y"

    def note(self, text: str) -> None:
        self._c.print("      [dim]{}[/dim]".format(text))


class Plan:
    def __init__(self, args) -> None:
        self.git = not (HOME / ".gitconfig").is_file()
        self.zshenv = not (HOME / ".zshenv").is_file()
        self.macism = not ok(["brew", "list", "macism"])
        self.ghostty = GHOSTTY_APPCFG.is_file()
        self.gh = not ok(["gh", "auth", "status"])

        self.ask_git = self.git and (args.name is None or args.email is None)
        self.ask_asc = self.zshenv and args.asc_key_id is None and not args.no_asc
        self.ask_macism = self.macism and args.macism is None
        self.ask_ghostty = self.ghostty and args.ghostty is None
        self.ask_gh = self.gh and args.gh is None

    def total(self) -> int:
        return (2 if self.ask_git else 0) + int(self.ask_asc) + int(self.ask_macism) \
            + int(self.ask_ghostty) + int(self.ask_gh)


class Answers:
    def __init__(self, args) -> None:
        self.name = args.name or ""
        self.email = args.email or ""
        self.asc_key_id = args.asc_key_id or ""
        self.macism = bool(args.macism)
        self.ghostty = bool(args.ghostty)
        self.gh = bool(args.gh)


def collect(ui: UI, plan: Plan, args) -> Answers:
    a = Answers(args)
    total = plan.total()
    if total == 0:
        return a

    p = Prompter(total)
    if not p.available:
        sys.exit("답이 {}개 부족한데 터미널이 없다. 플래그로 주거나 터미널에서 "
                 "실행할 것 (--help).".format(total))

    ui.console.print("[bold]질문 {}개[/bold] [dim]— 답하고 나면 끝까지 "
                     "멈추지 않는다[/dim]\n".format(total))

    if plan.ask_git:
        a.name = p.ask("git 사용자 이름")
        a.email = p.ask("git 이메일")
    if plan.ask_asc and p.ask_yn("이 기기에서 App Store Connect 배포를 하나?", False):
        a.asc_key_id = p.ask("ASC_KEY_ID")
    if plan.ask_macism:
        p.note("macism 은 nvim 의 한영 자동전환에 쓰인다.")
        p.note("서드파티 탭({})을 신뢰해야 설치된다.".format(TAP))
        a.macism = p.ask_yn("설치할까?", True)
    if plan.ask_ghostty:
        p.note("Ghostty 가 App Support 의 설정도 읽고, 그쪽이 이긴다.")
        a.ghostty = p.ask_yn("밀어둘까?", True)
    if plan.ask_gh:
        a.gh = p.ask_yn("GitHub 에 로그인할까? (맨 마지막에 브라우저)", True)

    ui.console.print()
    return a


# ── 단계 ─────────────────────────────────────────────────────────────
def step_tap(ui: UI, plan: Plan, a: Answers) -> None:
    with ui.step("서드파티 탭") as s:
        if not plan.macism:
            # 설치돼 있어도 탭이 미신뢰면 brew bundle 이 멈춘다. 값싸니 확인한다.
            run(["brew", "tap", TAP])
            run(["brew", "trust", TAP])
            s.skip("macism 이미 있음")
        elif a.macism:
            run(["brew", "tap", TAP])
            r = run(["brew", "trust", TAP])
            if r.returncode != 0:
                s.fail("탭 신뢰 실패", output=r.stdout)
            else:
                s.ok("{} 신뢰".format(TAP))
        else:
            s.warn("건너뜀 — 패키지 설치가 여기서 멈춘다",
                   hint="쓰지 않을 거면 Brewfile 에서 tap/macism 두 줄을 지울 것")


def step_gitconfig(ui: UI, plan: Plan, a: Answers) -> None:
    """없을 때만 신원을 적어 만든다. [include] 는 sync 가 본다.

    "이미 있음" 으로 건너뛰어도 공유분은 연결된다 — 예전에는 이 건너뛰기가
    곧 include 누락이었다.
    """
    with ui.step("~/.gitconfig") as s:
        if not plan.git:
            s.skip("이미 있음 — include 는 sync 가 본다")
            return
        (HOME / ".gitconfig").write_text(GITCONFIG.format(name=a.name, email=a.email))
        s.ok("{} <{}>".format(a.name, a.email))


def step_zsh(ui: UI, plan: Plan, a: Answers) -> None:
    """zsh 로컬 파일 3개. 없을 때만 만들고, 있으면 sync 가 source 줄만 본다."""
    with ui.step("zsh 로컬 파일") as s:
        made = []
        if plan.zshenv:
            text = ZSHENV + (ZSHENV_ASC.format(key_id=a.asc_key_id)
                             if a.asc_key_id else "")
            (HOME / ".zshenv").write_text(text)
            made.append("~/.zshenv" + (" (ASC 포함)" if a.asc_key_id else ""))
        for name, body in (("​.zprofile", ZPROFILE), (".zshrc", ZSHRC)):
            path = HOME / name.strip("​")
            if not path.is_file():
                path.write_text(body)
                made.append("~/" + name.strip("​"))
        if made:
            s.ok("{}개 만듦".format(len(made)))
            for m in made:
                ui.note(m)
        else:
            s.skip("이미 있음")


def step_ghostty(ui: UI, plan: Plan, a: Answers) -> None:
    with ui.step("Ghostty") as s:
        if not plan.ghostty:
            s.skip("충돌 없음")
        elif a.ghostty:
            GHOSTTY_APPCFG.rename(
                GHOSTTY_APPCFG.with_name(GHOSTTY_APPCFG.name + ".bak-" + STAMP))
            s.ok("App Support 설정을 밀어둠 (.bak-{})".format(STAMP))
        else:
            s.warn("그대로 둠 — 테마·폰트가 저장소 설정과 다를 수 있다",
                   hint="확인: ghostty +show-config | grep -E '^(theme|font-family)'")


def step_sync(ui: UI) -> None:
    """링크·패키지는 sync 에 맡긴다. 목록을 두 곳에 두지 않기 위해서다.

    sync 의 출력을 그대로 끼워넣지 않는다 — 헤더가 중첩되고 sync 의 마무리
    문구가 setup 한가운데 나와서 다 끝난 것처럼 보인다. 성공하면 한 줄,
    실패했을 때만 sync 가 낸 안내를 그대로 보여준다.
    """
    with ui.step("링크 · 패키지") as s:
        s.progress("brew bundle 은 몇 분 걸릴 수 있다…")
        r = run([str(DOTFILES / "bin/sync")])
        if r.returncode == 0:
            s.ok("정상")
        else:
            # sync 의 출력을 여기 끼워넣지 않는다. 이미 들여쓰기와 기호가
            # 붙은 텍스트라 한 번 더 감싸면 줄바꿈이 깨지고 읽을 수 없다.
            # 자세한 내용은 sync 를 직접 돌리면 제대로 나온다.
            s.fail("확인 필요",
                   output=r.stdout if ui.verbose else "",
                   hint="자세히 보려면:  ~/dotfiles/bin/sync")


def step_nvim(ui: UI) -> None:
    with ui.step("nvim 플러그인") as s:
        if shutil.which("nvim") is None:
            s.warn("nvim 이 없다 — 패키지 설치가 실패했을 수 있다")
            return
        s.progress("내려받는 중 (첫 실행이면 몇 분)…")
        r = run(["nvim", "--headless", "+qa"])
        if r.returncode != 0:
            s.warn("동기화 중 오류", hint="nvim 을 직접 열어 확인할 것")
            return
        s.ok("동기화 완료")


def step_gh(ui: UI, plan: Plan, a: Answers) -> None:
    with ui.step("GitHub") as s:
        if not plan.gh:
            s.skip("이미 로그인됨")
        elif not a.gh:
            s.skip("건너뜀 — 나중에 gh auth login")
        else:
            s._stop()
            ui.console.print("      [dim]브라우저가 열린다…[/dim]")
            if run(["gh", "auth", "login"], capture=False).returncode != 0:
                s.warn("로그인하지 않음", hint="나중에: gh auth login")
                return
            run(["gh", "auth", "setup-git"], capture=False)
            s.ok("로그인 + credential helper")


# ── 진입점 ───────────────────────────────────────────────────────────
def parse_args():
    ap = argparse.ArgumentParser(
        description="새 기기 첫 세팅. 답을 플래그로 주면 아무것도 묻지 않는다.")
    ap.add_argument("--name", help="git user.name")
    ap.add_argument("--email", help="git user.email")
    ap.add_argument("--asc-key-id", help="App Store Connect 키 ID")
    ap.add_argument("--no-asc", action="store_true", help="ASC 를 쓰지 않는다")
    ap.add_argument("--macism", dest="macism", action="store_true", default=None,
                    help="macism 설치 (서드파티 탭 신뢰)")
    ap.add_argument("--no-macism", dest="macism", action="store_false")
    ap.add_argument("--ghostty", dest="ghostty", action="store_true", default=None,
                    help="충돌하는 Ghostty 설정을 밀어둔다")
    ap.add_argument("--no-ghostty", dest="ghostty", action="store_false")
    ap.add_argument("--gh", dest="gh", action="store_true", default=None,
                    help="gh auth login 실행")
    ap.add_argument("--no-gh", dest="gh", action="store_false")
    ap.add_argument("-v", "--verbose", action="store_true", help="생략 없이 전부")
    return ap.parse_args()


def main() -> int:
    if not (DOTFILES / ".git").exists():
        print("{} 가 git 저장소가 아니다.".format(DOTFILES), file=sys.stderr)
        return 2

    args = parse_args()
    ui = UI(verbose=args.verbose)
    ui.title("dotfiles setup", os.uname().nodename)

    plan = Plan(args)
    a = collect(ui, plan, args)

    step_tap(ui, plan, a)
    step_gitconfig(ui, plan, a)
    step_zsh(ui, plan, a)
    step_ghostty(ui, plan, a)
    step_sync(ui)
    step_nvim(ui)
    step_gh(ui, plan, a)

    code = ui.done("끝났다 — 새 셸을 열거나: exec zsh")
    if a.asc_key_id:
        ui.console.print("\n[bold]ASC 는 두 가지가 더 필요하다[/bold] "
                         "[dim](스크립트가 못 하는 것)[/dim]")
        ui.hint("개인키를 ~/.appstoreconnect/private_keys/ 로 복사 (다른 기기에서)\n"
                "GUI 터미널에서: security add-generic-password -U "
                "-s ASC_ISSUER_ID -a \"$USER\" -w '<issuer-id>'")
    return code


if __name__ == "__main__":
    sys.exit(main())
